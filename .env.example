# Copy to .env and fill in. Never commit .env.

# Dhan (https://dhanhq.co/docs/v2/authentication/). TOTP must be enabled on the account;
# DHAN_TOTP_SECRET is the base32 secret shown when you set TOTP up (the text version of the QR code).
DHAN_CLIENT_ID=
# PIN + TOTP secret belong ONLY on the machine that generates tokens (the VM). A new
# token kills the old one everywhere, so a second machine with these fights the VM.
DHAN_PIN=
DHAN_TOTP_SECRET=
# Alternative to PIN + TOTP: a token generated on web.dhan.co (valid 24 h, no auto-refresh).
DHAN_ACCESS_TOKEN=

# Dashboard login (single user). Required for `serve`; `demo` generates one if unset.
DASHBOARD_PASSWORD=

# Gemini API key for classifying BusinessLine headlines (aistudio.google.com/apikey).
# Without it, BusinessLine items stay pending; NSE filings are still classified by rules.
GEMINI_API_KEY=

# Optional: Finnhub key (free, personal use) for earnings expectations on the Results board.
# Without it the board shows figures stated in BusinessLine headlines, or only the stock reaction.
FINNHUB_API_KEY=

# Set to 1 only on the token source (the VM). Elsewhere token generation refuses unless
# the command carries --i-know-this-kills-the-vm-token.
DHAN_TOKEN_AUTHORITY=
