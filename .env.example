# Copy to .env and fill in. Never commit .env.

# Dhan (https://dhanhq.co/docs/v2/authentication/). TOTP must be enabled on the account;
# DHAN_TOTP_SECRET is the base32 secret shown when you set TOTP up (the text version of the QR code).
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
# Alternative to PIN + TOTP: a token generated on web.dhan.co (valid 24 h, no auto-refresh).
DHAN_ACCESS_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
