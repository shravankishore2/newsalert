# Dashboard over live data. Localhost only; Caddy terminates HTTPS in front of it.
[Unit]
Description=newsalert dashboard (live)
After=network-online.target
Wants=network-online.target
# never stop retrying after repeated failures (default gives up after 5 in 10 s)
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/newsalert
ExecStart=/home/ubuntu/newsalert/.venv/bin/python -m newsalert serve --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
