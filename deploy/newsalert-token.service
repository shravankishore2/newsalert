# Fresh 24 h Dhan token before the session (08:30 IST, ahead of the monitor's own 08:45 pre-open check), so the 09:10 monitor never starts on a
# token that could expire mid-session. The monitor's own ExecStartPre=token is the second chance.
[Unit]
Description=newsalert Dhan token refresh (pre-open)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=6

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/newsalert
ExecCondition=/home/ubuntu/newsalert/.venv/bin/python -m newsalert is-trading-window --until 15:35
ExecStart=/home/ubuntu/newsalert/.venv/bin/python -m newsalert token --force
Restart=on-failure
RestartSec=60
