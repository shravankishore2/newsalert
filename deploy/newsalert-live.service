# Live monitor for one NSE session. Started by newsalert-live.timer at 09:10 IST on weekdays and
# also enabled at boot, so a reboot mid-session brings it back (a timer only catches up missed runs);
# ExecCondition skips NSE holidays (config.yaml) and anything after 15:35 without marking a failure.
[Unit]
Description=newsalert live monitor (NSE session)
After=network-online.target
Wants=network-online.target
# never stop retrying after repeated failures (default gives up after 5 in 10 s)
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/newsalert
ExecCondition=/home/ubuntu/newsalert/.venv/bin/python -m newsalert is-trading-window --until 15:35
# Make sure the Dhan token outlives the session before polling starts.
ExecStartPre=/home/ubuntu/newsalert/.venv/bin/python -m newsalert token
ExecStart=/home/ubuntu/newsalert/.venv/bin/python -m newsalert live --until 15:35
Restart=on-failure
RestartSec=30
# Backstop in case --until never triggers: 09:10 + 6.5 h = 15:40.
RuntimeMaxSec=6h30min
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
